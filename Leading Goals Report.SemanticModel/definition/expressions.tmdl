expression stg_LeadingGoalsMetrics =
		let
		    Source = src_LeadingGoalsMetrics,
		    Typed = Table.TransformColumnTypes(Source, {
		        {"MetricKey", type text},
		        {"DisplayName", type text},
		        {"ImperativeKey", type text},
		        {"SharedImperative", type text},
		        {"ImperativeOrder", Int64.Type},
		        {"GoalStatement", type text},
		        {"MetricOrder", Int64.Type},
		        {"Status", type text},
		        {"ScoreType", type text},
		        {"AYTItemCode", type text}
		    })
		in
		    Typed
