expression src_LeadingGoalsMetrics =
		let
		    Site = "https://fisherpaykel.sharepoint.com/sites/HRAnalytics",
		    FileName = "leading_goals_metrics.parquet",
		    FolderSuffix = "/03_Leading_Goals_Model/01_Source_Staged/Reference",
		    Files = SharePoint.Files(Site, [ApiVersion = 15]),
		    Candidates = Table.SelectRows(
		        Files,
		        each Comparer.OrdinalIgnoreCase([Name], FileName) = 0
		    ),
		    Matches = Table.SelectRows(
		        Candidates,
		        each Text.EndsWith(
		            Text.TrimEnd(Text.Replace([Folder Path], "%20", " "), "/"),
		            FolderSuffix,
		            Comparer.OrdinalIgnoreCase
		        )
		    ),
		    Content =
		        if Table.RowCount(Matches) = 1 then
		            Matches{0}[Content]
		        else
		            error "Expected exactly one matching file. Check the Candidates step.",
		    Data = Parquet.Document(Content)
		in
		    Data
	lineageTag: bbe33f41-b1d0-459b-94f1-72666fafed85
	queryGroup: 'Source Queries'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

