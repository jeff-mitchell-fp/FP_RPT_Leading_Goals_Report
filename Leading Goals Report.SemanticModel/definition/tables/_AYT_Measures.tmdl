		sourceLineageTag: 26892c59-e658-4a7e-bc76-8d76185f4fd5
		dataCategory: Uncategorized

	/// HELPER: _Agreement Respondents Base
	/// Sums valid scored-response counts in the current filter context.
	/// Counts across questions or surveys do not represent unique people.
	measure '_Agreement Respondents Base' = EXTERNALMEASURE("_Agreement Respondents Base", INTEGER, "DirectQuery to AS - AYT_Metrics")
		formatString: 0
		isHidden
		displayFolder: Agreement Score\_Helpers
		lineageTag: 656bb682-a223-4dc9-81b0-20fc2ed15bf0
		sourceLineageTag: e9db3a5d-920e-4007-943d-5e8a1ae62491
		dataCategory: Uncategorized

	/// HELPER: _Agreement Score Base
	/// Returns the response-weighted decimal agreement score from component bases.
	/// Calling measures supply reporting scope. An empty denominator returns blank.
	measure '_Agreement Score Base' = EXTERNALMEASURE("_Agreement Score Base", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Agreement Score\_Helpers
		lineageTag: c5bdc6c9-e89f-4004-b1cf-41faf9d0a801
		sourceLineageTag: 806499c1-7437-4862-a35f-3631f4d5e4c4
		dataCategory: Uncategorized

	/// PRESENTATION: Agreement Score
	/// Returns the response-weighted agreement score for one Weighted Average
	/// question and the resolved survey, within report-filtered organisational scope.
	/// Returns blank for multiple questions or no valid scored responses.
	/// Full Business includes UNATTRIBUTED; organisational detail and subsets exclude it.
	/// Use: Cards, question and organisational tables/matrices, and trends with time totals disabled.
	measure 'Agreement Score' = EXTERNALMEASURE("Agreement Score", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Agreement Score
