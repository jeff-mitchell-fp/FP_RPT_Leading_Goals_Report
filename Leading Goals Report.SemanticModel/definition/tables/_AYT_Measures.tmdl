	/// PRESENTATION: Response Count
	/// Returns observed response counts for one Distribution question and the
	/// resolved survey within report-filtered organisational scope. Preserves option
	/// filters; Full Business includes UNATTRIBUTED, while detail and subsets exclude it.
	/// Counts valid answers to one question, not full survey completions or unique people across questions/surveys.
	/// Use: Cards, response-option and organisational tables/matrices, and trends with time totals disabled.
	measure 'Response Count' = EXTERNALMEASURE("Response Count", INTEGER, "DirectQuery to AS - AYT_Metrics")
		formatString: 0
		displayFolder: Distribution
		lineageTag: 04e3f752-98bb-499e-848c-305df5d47293
		sourceLineageTag: 497a9988-0928-4d8b-a30f-ffdede21a5f6
		dataCategory: Uncategorized

	/// PRESENTATION: Response %
	/// Returns one directly filtered option's share of all valid answered responses
	/// for one Distribution question and the resolved survey within report-filtered
	/// organisational scope. Multiple-option or unrestricted option summaries return blank.
	/// Use: Single-option cards, response-option charts and organisational tables/matrices; disable time totals.
	measure 'Response %' = EXTERNALMEASURE("Response %", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Distribution
		lineageTag: c86bda2c-10eb-46f9-9a4e-b6ef03066f5e
		sourceLineageTag: 6df176cc-e4b3-4dde-a351-cc0ec5d66897
		dataCategory: Uncategorized

	/// HELPER: _Affirmative Response Count Base
	/// Returns the mapped affirmative-option count for one supported Distribution
	/// question, ignoring response-option filters. Missing affirmative rows remain blank.
	measure '_Affirmative Response Count Base' = EXTERNALMEASURE("_Affirmative Response Count Base", INTEGER, "DirectQuery to AS - AYT_Metrics")
		formatString: 0
		isHidden
		displayFolder: Affirmative Response\_Helpers
		lineageTag: 1fc203d6-71d1-4d82-ae01-cb5f94406fc8
		sourceLineageTag: ee20a072-c789-4fb9-adb5-d3c8391df73b
		dataCategory: Uncategorized

	/// HELPER: _Affirmative Response % Base
	/// Divides the affirmative-response count base by the all-valid-answered count
	/// base. An empty or zero denominator returns blank.
	measure '_Affirmative Response % Base' = EXTERNALMEASURE("_Affirmative Response % Base", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Affirmative Response\_Helpers
		lineageTag: 71efe155-17e2-40a4-b51b-9de04a9f076c
		sourceLineageTag: 70ef07c2-42e6-4a6e-a922-335b7111535f
		dataCategory: Uncategorized

	/// PRESENTATION: Affirmative Response %
	/// Returns the mapped affirmative share for one M1 or M3 question and the
	/// resolved survey within report-filtered organisational scope. Ignores response-option
	/// filters; Full Business includes UNATTRIBUTED, while detail and subsets exclude it.
	/// Use: Question and organisational cards/tables/matrices, and trends with time totals disabled; not for response-option rows.
	measure 'Affirmative Response %' = EXTERNALMEASURE("Affirmative Response %", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Affirmative Response
		lineageTag: aae322ea-5137-417f-b8c1-278ccc933010
		sourceLineageTag: 6c5fafc7-6d23-45b9-b559-7120caaf028d
