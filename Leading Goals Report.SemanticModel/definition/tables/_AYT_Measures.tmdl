	/// HELPER: _Survey Month Available
	/// Returns 1 when the current month/survey context contains a matching
	/// nonfuture applicability row; otherwise returns 0.
	/// Use: Visual-level filter on reporting-month and survey slicers; require 1. Not for display or calculations.
	measure '_Survey Month Available' = EXTERNALMEASURE("_Survey Month Available", INTEGER, "DirectQuery to AS - AYT_Metrics")
		formatString: 0
		displayFolder: _Global Helpers
		lineageTag: 5f8794be-2c56-41ac-b8ed-93e4d7459f3a
		sourceLineageTag: a3f360e3-5b07-4254-8372-b24dc49a90e9
		dataCategory: Uncategorized

	/// HELPER: _Category Score Base
	/// Returns the equal-weight mean of unrounded valid agreement question
	/// scores in the current context. Missing scores are excluded; zeros remain.
	measure '_Category Score Base' = EXTERNALMEASURE("_Category Score Base", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Category Score\_Helpers
		lineageTag: 1ea97131-0852-406f-beb0-b4481f487320
		sourceLineageTag: d324f4e2-ed25-4f3a-9db6-c31c3b738cbc
		dataCategory: Uncategorized

	/// PRESENTATION: Category Score
	/// Returns one category's equal-weight mean of valid question scores for
	/// the resolved survey and report-filtered organisational population. Ignores
	/// question, other item and response-option filters, including IncludeLeadingGoals.
	/// Requires one directly scoped category; no category, multiple categories or no valid question scores return blank.
	/// A question selection alone does not select its category. Valid zero question scores remain included.
	/// Full Business includes UNATTRIBUTED;
	/// organisational detail and subsets exclude it.
	/// Use: Category cards, category and organisational tables/matrices, and trends with time totals disabled.
	measure 'Category Score' = EXTERNALMEASURE("Category Score", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Category Score
		lineageTag: b5d09817-c68e-4732-a5b7-ec4193db8ba4
		sourceLineageTag: be42ed88-8aa8-4565-a8db-6db48e08e954
		dataCategory: Uncategorized

	/// HELPER: _Exclude Unattributed
	/// Returns 1 for organisational detail or a restricted eligible population; otherwise 0.
	/// Calling measures use this flag to exclude UNATTRIBUTED while retaining it in unrestricted Full Business totals.
	/// IncludeAYT defines the comparison baseline only; reports control eligibility filtering.
	measure '_Exclude Unattributed' = EXTERNALMEASURE("_Exclude Unattributed", INTEGER, "DirectQuery to AS - AYT_Metrics")
		formatString: 0
		isHidden
		displayFolder: _Global Helpers
		lineageTag: 390ff5d8-9ac4-4644-97e2-b9af6f82fda8
		sourceLineageTag: 21983c8a-e477-4a2f-ac16-297502abd2a9
		dataCategory: Uncategorized

	/// HELPER: _Selected Platform Name
	/// Returns Full Business for unrestricted organisational scope, otherwise the uniquely resolved Platform.
	/// Empty, missing or multiple-Platform contexts return blank.
	/// Use: Titles and header text only. Not for calculations.
	measure '_Selected Platform Name 2' = EXTERNALMEASURE("_Selected Platform Name", STRING, "DirectQuery to AS - AYT_Metrics")
		displayFolder: _Global Helpers
		lineageTag: 4b342b0a-ce15-414e-bac3-4c4903af8a22
		sourceLineageTag: 77d570fc-2878-4671-8be4-5afdb4281562
		dataCategory: Uncategorized

	/// HELPER: _Selected BU Name
	/// Returns the effective selected BU name or Multiple Business Units when BU name/code is directly filtered.
	/// Returns blank without a direct BU restriction or when no selected BU remains.
	/// Use: Titles and header text only. Not for calculations.
	measure '_Selected BU Name 2' = EXTERNALMEASURE("_Selected BU Name", STRING, "DirectQuery to AS - AYT_Metrics")
		displayFolder: _Global Helpers
		lineageTag: d46abc62-0b8e-4c59-a79a-28959ca69f3a
		sourceLineageTag: a0a6a0e0-5e44-4aaa-922d-d78cd95e6322
		dataCategory: Uncategorized

	/// HELPER: _Selected Survey Name
	/// Returns the full name of the survey resolved by _Reporting SurveyCode.
	/// Invalid, conflicting, multiple or unavailable time contexts return blank.
	/// Use: Titles and header text only. Not for calculations.
	measure '_Selected Survey Name' = EXTERNALMEASURE("_Selected Survey Name", STRING, "DirectQuery to AS - AYT_Metrics")
		displayFolder: _Global Helpers
		lineageTag: e115bf5f-6335-475a-aa92-ef5de1c269e7
		sourceLineageTag: 1226257b-3a57-4b6a-82c2-78b0b8c329de
		dataCategory: Uncategorized

	/// HELPER: _Selected Category Name
	/// Returns one nonblank directly scoped category, independently of other item filters and score availability.
	/// Absent, blank or multiple categories return blank.
	/// Use: Titles and header text only. Not for calculations.
	measure '_Selected Category Name' = EXTERNALMEASURE("_Selected Category Name", STRING, "DirectQuery to AS - AYT_Metrics")
		displayFolder: _Global Helpers
		lineageTag: 5bf8bf02-10bf-42e4-8202-40e55a5fc051
		sourceLineageTag: a77c453b-c1f8-44d6-bd54-f2fe983cd58d
		dataCategory: Uncategorized

	/// PRESENTATION: Avg Score
	/// Returns the equal-weight mean of valid agreement question scores for the resolved
	/// survey and report-filtered organisational population. Ignores item and response-option filters.
	/// Full Business includes UNATTRIBUTED; organisational detail and subsets exclude it.
	/// Unavailable scores return blank.
	/// Use: Cards, organisational tables/matrices, and trends with time totals disabled.
	measure 'Avg Score' = EXTERNALMEASURE("Avg Score", DOUBLE, "DirectQuery to AS - AYT_Metrics")
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Avg Score
		lineageTag: bb6a6bfa-5938-4b42-af8e-9f86b4688c23
		sourceLineageTag: 0aee91ea-8ecb-4809-a406-8596770c84fb
		dataCategory: Uncategorized

	partition _AYT_Measures = entity
		mode: directQuery
		source
			entityName: _Measures
			expressionSource: 'DirectQuery to AS - AYT_Metrics'

	changedProperty = Name

