		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("__FTE Actual Total FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual Female %
	/// Female FTE as a proportion of total FTE (all genders) at the selected reporting month.
	/// Use: Cards only. Share of the all-gender total, including Unknown; not for tables.
	measure 'FTE Actual Female %' = EXTERNALMEASURE("FTE Actual Female %", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: d06bd0e7-fd42-4861-bed6-f6c9990c1ec7
