	/// HELPER: _Reporting MonthStartDate
	/// Resolve the reporting month.
	/// SELECTEDVALUE reads from CalMonthYear (the slicer column).
	/// Translates the text label e.g. "January 2026" into the
	/// corresponding MonthStartDate for use in fact table filters.
	/// Falls back to the latest month with staged actuals data
	/// when no slicer selection is made.
	/// Use: Calculation input only; do not place on visuals.
	measure '_Reporting MonthStartDate' = EXTERNALMEASURE("_Reporting MonthStartDate", DATETIME, "DirectQuery to AS - HR_Metrics")
		displayFolder: _Global Helpers
		lineageTag: f18268cc-e387-4220-85b3-0e5096432608
		sourceLineageTag: 6c701562-e4c6-44fa-b514-07cfa383c206
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("__Reporting MonthStartDate FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// HELPER: _FTE Actual Base
	/// Base FTE aggregation.
	/// Raw SUM with no filters — all filtering handled by the calling measures. Do not use directly in visuals.
	measure '_FTE Actual Base' = EXTERNALMEASURE("_FTE Actual Base", DOUBLE, "DirectQuery to AS - HR_Metrics")
		isHidden
		displayFolder: FTE\_Helpers
		lineageTag: 345c4bdf-27c2-42ed-a24d-1cfd61b7600a
		sourceLineageTag: d1285551-f5c1-4cba-b560-5a85929c5f84
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("__FTE Actual Base FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual Female
	/// Same as FTE Actual with an additional Gender filter applied through the dim_Gender relationship.
	/// Use: Cards and charts only. Gender is fixed in the measure, so it is not for Gender-rows tables; use FTE Actual there.
	measure 'FTE Actual Female' = EXTERNALMEASURE("FTE Actual Female", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: c69cdae4-f601-41df-baca-db206f02a63c
		sourceLineageTag: d184ec53-b26c-4472-aa80-29f4f85cbacf
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual Female FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual
	/// Filters via dim_Calendar relationship to the resolved reporting month. Follows the gender context; shows the total for the selected month when no gender is in context.
	/// Use: Cards, charts and tables, including Gender-rows tables (one column, gender in the rows).
	measure 'FTE Actual' = EXTERNALMEASURE("FTE Actual", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: 9094b663-e1bd-49fa-a6b4-6ec062cbdc63
		sourceLineageTag: a96a843b-db1f-46f6-87fd-e143dac5523d
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual Male
	/// Same pattern as FTE Actual Female.
	/// Use: Cards and charts only. Gender is fixed in the measure, so it is not for Gender-rows tables; use FTE Actual there.
	measure 'FTE Actual Male' = EXTERNALMEASURE("FTE Actual Male", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: c4bad9f4-ef1a-4ee2-8456-18ca2cd0c3f7
		sourceLineageTag: 72108a49-ca9a-4a8d-8a2f-b669574ce8d8
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual Male FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// HELPER: _FTE Actual Total
	/// FTE Actual Total.
	/// Removes Gender filter context entirely so this always returns the org-wide FTE regardless of any gender slicer.
	/// Used as the denominator in FTE gender % measures.
	/// Not for direct use in visuals.
	measure '_FTE Actual Total' = EXTERNALMEASURE("_FTE Actual Total", DOUBLE, "DirectQuery to AS - HR_Metrics")
		isHidden
		displayFolder: FTE\_Helpers
		lineageTag: 811df053-ae2f-44bd-8330-a32e0355a143
