		formatStringDefinition = EXTERNALMEASURE("_FTE Actual Male % FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual Exit Rate
	/// FTE Actual for December of the prior year, relative to the selected reporting month.
	/// Used as the Exit Rate comparison point across all metrics.
	/// REMOVEFILTERS clears any month slicer context, then the two column filters pin to December of the prior year.
	/// Use: Cards, charts and tables, including Gender-rows tables (one column, gender in the rows).
	measure 'FTE Actual Exit Rate' = EXTERNALMEASURE("FTE Actual Exit Rate", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: 2e6b5604-c0db-4483-a465-6bc60deaf89c
		sourceLineageTag: 13ece43a-5689-463e-8aa8-622c56e3e019
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual Exit Rate FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual PM
	/// FTE Actual for the prior month relative to the selected reporting month.
	/// EDATE shifts the resolved MonthStartDate back by 1 month, then we filter dim_Calendar to that date.
	/// REMOVEFILTERS clears any existing calendar filter context from the slicer before applying the new month filter.
	/// Use: Cards, charts and tables, including Gender-rows tables (one column, gender in the rows).
	measure 'FTE Actual PM' = EXTERNALMEASURE("FTE Actual PM", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: 26de9e43-6e71-4316-abe2-eab177af9acf
		sourceLineageTag: 87bafb29-17ae-4019-a6a9-6085926e3259
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual PM FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// PRESENTATION: FTE Actual SMLY
	/// FTE Actual for the same month 12 months prior to the selected reporting month.
	/// EDATE shifts the resolved MonthStartDate back by 12 months which always lands on the same month of the prior year.
	/// Use: Cards, charts and tables, including Gender-rows tables (one column, gender in the rows).
	measure 'FTE Actual SMLY' = EXTERNALMEASURE("FTE Actual SMLY", DOUBLE, "DirectQuery to AS - HR_Metrics")
		displayFolder: FTE
		lineageTag: c8114171-6f40-46f4-a4b6-fdfda95f7e95
		sourceLineageTag: 34e647b8-238e-4ecd-aaa5-b561deb1b8e7
		dataCategory: Uncategorized

		formatStringDefinition = EXTERNALMEASURE("_FTE Actual SMLY FormatString", STRING, "DirectQuery to AS - HR_Metrics")

	/// HELPER: _FTE Actual PM Total
	/// All-gender FTE for the prior month within the current organisational scope, with Gender filter removed.
	/// Used as the denominator in FTE Actual PM Female % and FTE Actual PM Male %.
	measure '_FTE Actual PM Total' = EXTERNALMEASURE("_FTE Actual PM Total", DOUBLE, "DirectQuery to AS - HR_Metrics")
		isHidden
		displayFolder: FTE\_Helpers
		lineageTag: b0582d53-9967-4a70-a30d-79876a37e0ee
