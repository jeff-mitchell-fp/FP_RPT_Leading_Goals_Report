	/// HELPER: _Net Movement Base
	/// Starters Base minus Total Leavers Base. No BLANK guard is needed:
	/// both operands sum the same fct_Actual rows, so they are BLANK together,
	/// and BLANK minus BLANK returns BLANK. A genuine zero is kept.
	measure '_Net Movement Base' = EXTERNALMEASURE("_Net Movement Base", DOUBLE, "DirectQuery to AS - HR_Metrics")
		isHidden
