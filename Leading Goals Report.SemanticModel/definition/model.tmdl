model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-NZ
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Source Queries'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Staged Queries'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Production Queries'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DirectQuery to AS - HR_Metrics","DirectQuery to AS - AYT_Metrics","_LG_Measures","Leading Goals Metric Catalog","Annual Targets and Goals","stg_LeadingGoalsMetrics","stg_AnnualTargetsAndGoals","src_LeadingGoalsMetrics","src_AnnualTargetsAndGoals"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_HR_BusinessUnit
ref table dim_HR_Calendar
ref table _HR_Measures
ref table dim_AYT_BusinessUnit
ref table dim_AYT_Item
ref table dim_AYT_Survey
ref table dim_AYT_Calendar
ref table _AYT_Measures
ref table _LG_Measures
ref table 'Leading Goals Metrics'
ref table 'Leading Goals Metric Catalog'
ref table 'Annual Targets and Goals'

ref cultureInfo en-US

